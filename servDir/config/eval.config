server {
	listen 8080;
	server_name eval.local;

	root ./servDir/;
	index index.html;

	error_page 400 404 /error_pages/404.html;
	error_page 500 /error_pages/500.html;

	location / {
		allowed_methods GET POST DELETE;
		root ./servDir/var/www/html;
		index index.html;
		cgi_extension .py;
		cgi_path ./servDir/var/www/cgi-bin/;
		upload_enable on;
		upload_store ./servDir/upload/;
	}

	location /only_get/ {
		allowed_methods GET;
		root ./servDir/var/www/html;
		index html1.html;
	}

	location /upload/ {
		allowed_methods GET POST DELETE;
		root ./servDir/upload/;
		upload_enable on;
		upload_store ./servDir/upload/;
		autoindex on;
	}

	location /autoindex/ {
		allowed_methods GET;
		root ./servDir/var/www/html;
		autoindex on;
	}

	location /redirect/ {
		return 301 https://profile.intra.42.fr/;
	}

	location /cgi-bin/ {
		allowed_methods GET POST;
		root ./servDir/var/www/cgi-bin/;
		cgi_extension .py;
		cgi_path ./servDir/var/www/cgi-bin/;
	}

	location /small_body/ {
		allowed_methods POST;
		root ./servDir/upload/;
		upload_enable on;
		upload_store ./servDir/upload/;
		client_max_body_size 10;
	}
}

server {
	listen 8080;
	server_name vhost2.local;

	root ./servDir/var/www/html;
	index html2.html;

	location / {
		allowed_methods GET;
		root ./servDir/var/www/html;
		index html2.html;
	}
}

server {
	listen 8081;
	server_name port8081.local;

	root ./servDir/var/www/html;
	index juanma.html;

	location / {
		allowed_methods GET;
		root ./servDir/var/www/html;
		index juanma.html;
	}
}
